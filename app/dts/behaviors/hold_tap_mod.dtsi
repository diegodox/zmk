 * SPDX-License-Identifier: MIT
 *
 * Generic &htm behavior:
 * - param1 = keycode for tap behavior
 * - param2 = keycode for hold behavior
 * - param3 = keycode for mod-triggered behavior
 * - param4 = bitmask of modifiers that activate mod behavior
 */

#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
#if ZMK_BEHAVIOR_OMIT(HTM)
        /omit-if-no-ref/
#endif
        htm: htm {
            compatible = "zmk,behavior-hold-tap-mod";
            #binding-cells = <4>;
            bindings = <&kp 0 &kp 0 &kp 0>; // dummy、param1〜3に上書きされる
            mods = <0>;  // param4 で上書き
            tapping-term-ms = <200>;
        };
    };
};
